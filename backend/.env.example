# Copy to backend/.env — never commit real secrets.

UMBRARO_ENV=development

# Generate a fresh secret for each environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-LOCAL-DEV-ONLY
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Async SQLAlchemy URL. For Postgres use postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./umbraro.db

# CORS allow-list for the Flutter app (comma-separated, no spaces).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5555

# ─── Sportradar API ──────────────────────────────────────────────────────────
# Required for fixtures, standings, and the player-position cross-check
# (backend/scripts/fetch_sportradar_positions.py +
#  backend/scripts/cross_check_positions_via_sportradar.py).
# Change /trial/ → /production/ in the URL when moving off the trial tier.
SPORTRADAR_API_KEY=PASTE_YOUR_SPORTRADAR_API_KEY_HERE
SPORTRADAR_BASE_URL=https://api.sportradar.com/soccer/trial/v4/en
SPORTRADAR_RATE_DELAY=1.1

# ─── Avatars (Part B): S3 presigned-upload storage ───────────────────────────
# Provisioned by infra/template.yaml (stack outputs AvatarsBucket /
# AvatarsPublicBaseUrl). The backend signs a presigned S3 PUT for key
# avatars/<user_id>.jpg and stores the public URL on the user row. On App Runner
# the instance role supplies the credentials, so no access keys are needed.
AVATARS_S3_BUCKET=ucluj-user-avatars
AVATARS_S3_REGION=eu-central-1

# ─── Instant chat (Part C): API Gateway WebSocket fan-out ─────────────────────
# Provisioned by infra/template.yaml (stack outputs WebSocketManagementEndpoint /
# ConnectionsTableName). FastAPI persists each message to RDS then fans it out to
# live connections via the API Gateway Management API. Leave the endpoint blank
# locally to disable fan-out (persistence + history still work).
WS_API_MANAGEMENT_ENDPOINT=
WS_CONNECTIONS_TABLE=umbraro-ws-connections

# ─── Demo mode ───────────────────────────────────────────────────────────────
# When DEMO_MODE=true the backend pretends "now" is DEMO_TODAY at noon UTC.
# All week-window, upcoming, and recent-fixture math pivots around that date,
# and the live Sportradar fetch + its caches are bypassed so the CSV-backed
# 2024-2025 dataset is the only data source. Use this for the committee
# presentation when the live season is over and the Sportradar trial feed
# returns no fixtures. Set DEMO_TODAY to a late-season date so the Wyscout
# per-90 KPIs that feed the Starting XI predictor are at their most stable.
DEMO_MODE=false
DEMO_TODAY=2025-04-15
